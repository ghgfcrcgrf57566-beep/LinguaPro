{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinguaPro lesson content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "lessons"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "content_version": { "type": "string", "minLength": 1 },
    "lessons": {
      "type": "array",
      "items": { "$ref": "#/$defs/lesson" }
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "language", "track", "description", "objectives", "vocabulary", "sections", "quiz"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "LEGAL"] },
        "language": { "enum": ["en"] },
        "track": { "enum": ["general-english", "legal-english"] },
        "description": { "type": "string", "minLength": 1 },
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "meaning", "example"],
            "properties": {
              "term": { "type": "string", "minLength": 1 },
              "meaning": { "type": "string", "minLength": 1 },
              "example": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "body"],
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 }
            }
          }
        },
        "quiz": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "options", "answer_index", "explanation"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "answer_index": { "type": "integer", "minimum": 0 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}