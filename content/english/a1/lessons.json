  "lessons": [
    {
      "id": "a1-greetings",
      "title": "Greetings and introductions",
      "level": "A1",
      "language": "en",
      "track": "general-english",
      "description": "Learn common greetings and how to introduce yourself politely.",
      "objectives": [
        "Use a basic greeting.",
        "Ask and answer someone's name.",
        "Introduce yourself with a short sentence."
      ],
      "vocabulary": [
        {
          "term": "Hello",
          "meaning": "مرحبًا",
          "example": "Hello, my name is Sara.",
          "pronunciation": "heh-LOH"
        },
        {
          "term": "Nice to meet you",
          "meaning": "سعيد بلقائك",
          "example": "Nice to meet you, Ahmed."
        },
        {
          "term": "My name is...",
          "meaning": "اسمي...",
          "example": "My name is Ali."
        }
      ],
      "sections": [
        {
          "heading": "Useful dialogue",
          "body": "A: Hello! What is your name?\\nB: My name is Sara. What is your name?\\nA: I'm Omar. Nice to meet you.\\nB: Nice to meet you, too."
        },
        {
          "heading": "Language tip",
          "body": "Use “What is your name?” to ask for a person's name. “I'm…” is a natural short form of “I am…”."
        }
      ],
      "quiz": [
        {
          "question": "Which sentence introduces your name?",
          "options": [
            "My name is Ali.",
            "Where are you?",
            "Good night."
          ],
          "answer_index": 0,
          "explanation": "“My name is…” is a common way to introduce yourself."
        }
      ]
    },
    {
      "id": "a1-likes",
      "title": "Talking about things you like",
      "level": "A1",
      "language": "en",
      "track": "general-english",
      "description": "Say what you like and ask another person about their preferences.",
      "objectives": [
        "Use “I like…” with a noun.",
        "Ask “What do you like?”",
        "Give a simple positive or negative answer."
      ],
      "vocabulary": [
        {
          "term": "book",
          "meaning": "كتاب",
          "example": "I like books."
        },
        {
          "term": "like",
          "meaning": "يحب / يعجبه",
          "example": "I like English."
        },
        {
          "term": "don't like",
          "meaning": "لا يحب / لا يعجبه",
          "example": "I don't like cold coffee."
        },
        {
          "term": "read",
          "meaning": "يقرأ",
          "example": "I read a book."
        },
        {
          "term": "music",
          "meaning": "موسيقى",
          "example": "I like music."
        }
      ],
      "sections": [
        {
          "heading": "Ask and answer",
          "body": "A: What do you like?\\nB: I like books. What about you?\\nA: I like music."
        },
        {
          "heading": "Language tip",
          "body": "Use “I like + noun” to talk about preferences. For example: “I like books.”"
        }
      ],
      "quiz": [
        {
          "question": "Choose the correct sentence.",
          "options": [
            "I likes books.",
            "I like books.",
            "I liking books."
          ],
          "answer_index": 1,
          "explanation": "With “I”, use the base verb “like”."
        }
      ]
    },
    {
      "id": "a1-daily-routine",
      "title": "Daily routines and simple verbs",
      "level": "A1",
      "language": "en",
      "track": "general-english",
      "description": "صف يومك بجمل قصيرة وتعلّم أفعالًا شائعة في الحياة اليومية.",
      "objectives": [
        "استخدام أفعال يومية في جمل بسيطة",
        "وصف بداية اليوم",
        "تكوين جملة صحيحة مع I"
      ],
      "vocabulary": [
        {
          "term": "wake up",
          "meaning": "يستيقظ",
          "example": "I wake up at seven.",
          "pronunciation": "wayk up"
        },
        {
          "term": "eat",
          "meaning": "يأكل",
          "example": "I eat breakfast in the morning.",
          "pronunciation": "eet"
        },
        {
          "term": "work",
          "meaning": "يعمل",
          "example": "I work every day.",
          "pronunciation": "wurk"
        },
        {
          "term": "study",
          "meaning": "يدرس",
          "example": "I study English after work.",
          "pronunciation": "STUH-dee"
        },
        {
          "term": "sleep",
          "meaning": "ينام",
          "example": "I sleep at night.",
          "pronunciation": "sleep"
        }
      ],
      "sections": [
        {
          "heading": "A simple daily routine",
          "body": "I wake up at seven. I eat breakfast. I work during the day, and I study English in the evening. I sleep at night."
        },
        {
          "heading": "Grammar tip",
          "body": "مع الضمير I نستخدم الفعل بصيغته الأساسية: I work, I study, I eat. لا نضيف s إلى الفعل مع I."
        }
      ],
      "quiz": [
        {
          "question": "Choose the correct sentence.",
          "options": [
            "I studies English.",
            "I study English.",
            "I studying English."
          ],
          "answer_index": 1,
          "explanation": "مع I نستخدم study دون s."
        },
        {
          "question": "What does “wake up” mean?",
          "options": [
            "ينام",
            "يستيقظ",
            "يعمل"
          ],
          "answer_index": 1,
          "explanation": "Wake up تعني يستيقظ."
        },
        {
          "question": "Complete: I ___ breakfast in the morning.",
          "options": [
            "eat",
            "eats",
            "eating"
          ],
          "answer_index": 0,
          "explanation": "نستخدم eat مع I."
        }
      ]
    },
    {
      "id": "a1-food-and-drinks",
      "title": "Food, drinks and ordering",
      "level": "A1",
      "language": "en",
      "track": "general-english",
      "description": "تعلم أسماء أطعمة ومشروبات واطلب شيئًا بأدب في مقهى أو مطعم.",
      "objectives": [
        "تسمية أطعمة ومشروبات شائعة",
        "استخدام I would like لطلب شيء",
        "السؤال عن السعر بطريقة بسيطة"
      ],
      "vocabulary": [
        {
          "term": "water",
          "meaning": "ماء",
          "example": "Can I have some water, please?",
          "pronunciation": "WAW-ter"
        },
        {
          "term": "bread",
          "meaning": "خبز",
          "example": "I eat bread for breakfast.",
          "pronunciation": "bred"
        },
        {
          "term": "menu",
          "meaning": "قائمة الطعام",
          "example": "Can I see the menu, please?",
          "pronunciation": "MEN-yoo"
        },
        {
          "term": "I'd like...",
          "meaning": "أودّ... / أريد بأدب",
          "example": "I'd like a cup of tea, please.",
          "pronunciation": "ayd lyk"
        },
        {
          "term": "How much?",
          "meaning": "بكم؟ / كم السعر؟",
          "example": "How much is the sandwich?",
          "pronunciation": "how much"
        }
      ],
      "sections": [
        {
          "heading": "At a café",
          "body": "Customer: Hello. I'd like a cup of tea, please.\\nServer: Of course. Would you like bread, too?\\nCustomer: No, thank you. How much is the tea?"
        },
        {
          "heading": "Language tip",
          "body": "استخدم I'd like بدل I want عندما تريد طلب شيء بأدب. أضف please لجعل الطلب ألطف."
        }
      ],
      "quiz": [
        {
          "question": "Which is a polite way to order tea?",
          "options": [
            "Give tea now.",
            "I'd like a cup of tea, please.",
            "I tea want."
          ],
          "answer_index": 1,
          "explanation": "I'd like... صيغة مهذبة لطلب شيء."
        },
        {
          "question": "What does menu mean?",
          "options": [
            "قائمة الطعام",
            "فاتورة الكهرباء",
            "محطة الحافلات"
          ],
          "answer_index": 0,
          "explanation": "Menu تعني قائمة الطعام أو المشروبات."
        },
        {
          "question": "Complete: How ___ is the sandwich?",
          "options": [
            "many",
            "much",
            "old"
          ],
          "answer_index": 1,
          "explanation": "نستخدم How much للسؤال عن السعر."
        }
      ]
    },
    {
      "id": "a1-places-and-directions",
      "title": "Places and asking for directions",
      "level": "A1",
      "language": "en",
      "track": "general-english",
      "description": "تعلم السؤال عن أماكن قريبة وفهم الاتجاهات الأساسية.",
      "objectives": [
        "السؤال عن موقع مكان",
        "فهم left وright وstraight",
        "استخدام Where is...?"
      ],
      "vocabulary": [
        {
          "term": "Where is...?",
          "meaning": "أين يوجد...؟",
          "example": "Where is the bus station?",
          "pronunciation": "wair iz"
        },
        {
          "term": "left",
          "meaning": "اليسار",
          "example": "Turn left at the street.",
          "pronunciation": "left"
        },
        {
          "term": "right",
          "meaning": "اليمين",
          "example": "The bank is on the right.",
          "pronunciation": "ryt"
        },
        {
          "term": "straight ahead",
          "meaning": "إلى الأمام مباشرة",
          "example": "Go straight ahead for two minutes.",
          "pronunciation": "strayt uh-HED"
        },
        {
          "term": "near",
          "meaning": "قريب من",
          "example": "The pharmacy is near the school.",
          "pronunciation": "neer"
        }
      ],
      "sections": [
        {
          "heading": "Asking for help",
          "body": "A: Excuse me, where is the pharmacy?\\nB: Go straight ahead, then turn left. It is near the school.\\nA: Thank you!"
        },
        {
          "heading": "Language tip",
          "body": "استخدم Where is...? للسؤال عن المكان. Turn left تعني انعطف يسارًا، وturn right تعني انعطف يمينًا."
        }
      ],
      "quiz": [
        {
          "question": "What does turn left mean?",
          "options": [
            "انعطف يمينًا",
            "انعطف يسارًا",
            "واصل النوم"
          ],
          "answer_index": 1,
          "explanation": "Left تعني اليسار."
        },
        {
          "question": "Choose the correct question.",
          "options": [
            "Where the bank?",
            "Where is the bank?",
            "Where bank is? "
          ],
          "answer_index": 1,
          "explanation": "الصيغة الصحيحة للسؤال عن مكان مفرد هي Where is the...?"
        }
      ]
    },
    {
